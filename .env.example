# ===== 真实 LLM：阿里云百炼 DashScope（OpenAI 兼容）=====
MOCK_LLM=false
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=sk-your-dashscope-key
LLM_MODEL=deepseek-v4.1-flash
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=2
LLM_RETRY_BACKOFF_SECONDS=0.5

# 真实模型默认只用于学生提问/聊天；答题反馈走模板以控制成本。
TUTOR_LLM_FOR_ANSWERS=false

# ===== PostgreSQL =====
# 运行 scripts/init_db.sql 后使用；想回退 SQLite 就注释掉 DATABASE_URL
DATABASE_URL=postgresql://multi_agent:multi_agent_dev@127.0.0.1:5432/multi_agent
SQLITE_PATH=knowledge.db
DB_POOL_MIN=1
DB_POOL_MAX=10

# 登录会话有效期（小时）
SESSION_TTL_HOURS=24

# CORS 白名单（逗号分隔，必须是明确 origin，不能是 *）
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
# 同一“学校+邮箱+IP”在窗口内失败达到上限后锁定
LOGIN_MAX_FAILURES=5
# 同一来源 IP 跨账号失败总量阈值，防撞库
LOGIN_IP_MAX_FAILURES=30
LOGIN_WINDOW_SECONDS=900
LOGIN_LOCK_SECONDS=900

# WebSocket 一次性 ticket 有效期（秒）；生产不要开启旧的 ?token= 兼容
WS_TICKET_TTL_SECONDS=30
WS_ALLOW_QUERY_TOKEN=false
# WS 单帧最大字符数
WS_MAX_MESSAGE_CHARS=4096

# 交互限流（按用户/每分钟；进程内实现，多实例需换共享存储）
SUBMIT_RATE_PER_MINUTE=30
MESSAGE_RATE_PER_MINUTE=10

# 生产环境建议 false，并由 alembic upgrade head 管理表结构
AUTO_APPLY_SCHEMA=true

# 平台运维开通新学校；留空则关闭 /auth/organizations
# 生产环境请设置强随机值并放入 Secrets Manager
PLATFORM_ADMIN_TOKEN=

# ===== 教学策略 =====
MASTERY_THRESHOLD=0.6
WEAKNESS_THRESHOLD=0.3
HINT_AFTER_ATTEMPTS=2
# 答错后第几次尝试才揭示标准答案；设为 1 等于每次都揭示（不建议）
ANSWER_REVEAL_AFTER_ATTEMPTS=2