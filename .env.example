# ===== 真实 LLM：阿里云百炼 DashScope（OpenAI 兼容）=====
MOCK_LLM=false
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=sk-your-dashscope-key
LLM_MODEL=deepseek-v4.1-flash
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=2
LLM_RETRY_BACKOFF_SECONDS=0.5

# 真实模型默认只用于学生提问/聊天；答题反馈走模板以控制成本。
TUTOR_LLM_FOR_ANSWERS=false

# ===== PostgreSQL =====
# 运行 scripts/init_db.sql 后使用；想回退 SQLite 就注释掉 DATABASE_URL
DATABASE_URL=postgresql://multi_agent:multi_agent_dev@127.0.0.1:5432/multi_agent
SQLITE_PATH=knowledge.db
DB_POOL_MIN=1
DB_POOL_MAX=10

# 登录会话有效期（小时）
SESSION_TTL_HOURS=24

# 生产环境建议 false，并由 alembic upgrade head 管理表结构
AUTO_APPLY_SCHEMA=true

# 平台运维开通新学校；留空则关闭 /auth/organizations
# 生产环境请设置强随机值并放入 Secrets Manager
PLATFORM_ADMIN_TOKEN=

# ===== 教学策略 =====
MASTERY_THRESHOLD=0.6
WEAKNESS_THRESHOLD=0.3
HINT_AFTER_ATTEMPTS=2